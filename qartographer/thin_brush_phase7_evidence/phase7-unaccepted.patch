+TEST(phase7, CompleteRegionCoverage)
+{
+    Phase5Reset();
+    auto box = [](qvec3d lo, qvec3d hi) {
+        auto region = bspbrush_t::make_ptr();
+        for (int k=0;k<3;++k) for (double sign : {-1.,1.}) {
+            qplane3d p{};p.normal[k]=sign;p.dist=sign<0 ? -lo[k]:hi[k];
+            region->sides.emplace_back().planenum=Phase5Plane(p);
+        }
+        return region;
+    };
+    auto node = box({-1,-1,-1},{1,1,1});
+    auto enclosing = box({-2,-2,-2},{2,2,2});
+    EXPECT_TRUE(SupportedCoversRegion(*enclosing,*node));
+    auto wall = box({0,-2,-2},{std::ldexp(1.,-45),2,2});
+    EXPECT_FALSE(SupportedCoversRegion(*wall,*node));
+    EXPECT_FALSE(SupportedCoversRegion(*node,*wall));
+    auto fragment = box({0,-.5,-.5},{std::ldexp(1.,-45),.5,.5});
+    EXPECT_TRUE(SupportedCoversRegion(*node,*fragment));
+    EXPECT_FALSE(SupportedCoversRegion(*fragment,*node));
+    EXPECT_TRUE(SupportedCoversRegion(*enclosing,*node,true));
+    auto microscopic = box({208,0,0},{std::nextafter(208.,209.),1,1});
+    auto containing = box({207,-1,-1},{209,2,2});
+    EXPECT_TRUE(SupportedCoversRegion(*containing,*microscopic));
+    EXPECT_FALSE(SupportedCoversRegion(*containing,*microscopic,true)); // target has no volume
+    auto contact = box({0,0,0},{0,1,1});
+    EXPECT_FALSE(SupportedCoversRegion(*node,*contact)); // not a volumetric coverage proof
+
+}
