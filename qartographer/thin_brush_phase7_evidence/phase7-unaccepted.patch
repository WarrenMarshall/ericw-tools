+TEST(phase5, NarrowQuadrilateralRankAndRealization)
+{
+    Phase5Reset();
+    std::ifstream file("/tmp/qqbsp-phase7/source/qartographer/phase5-witness.json");
+    nlohmann::json data; file >> data;
+    auto toplane = [](auto p) { return qplane3d{{p[0].template get<double>(),p[1].template get<double>(),p[2].template get<double>()},p[3].template get<double>()}; };
+    qplane3d partition = toplane(data["partition"]);
+    winding_t cap;
+    for (auto v : data["cap"]["vertices"]) cap.push_back({v[0],v[1],v[2]});
+    EXPECT_TRUE(WindingIsTiny(cap, 0.0001)); // former policy rejects this valid cut
+    EXPECT_EQ(supported_geometry::winding_rank(cap, partition), supported_geometry::rank_t::area);
+    auto brush = bspbrush_t::make_ptr();
+    for (auto f : data["region"]) {
+        auto &side = brush->sides.emplace_back();
+        side.planenum = Phase5Plane(toplane(f["p"]));
+        for (auto v : f["w"]) side.w.push_back({v[0],v[1],v[2]});
+    }
+    for (auto constraint : data["cap"]["ancestor_constraints"]) {
+        auto plane = toplane(constraint["p"]);
+        bool present = false;
+        for (auto &side : brush->sides)
+            present |= side.get_plane().get_normal() == plane.normal && side.get_plane().get_dist() == plane.dist;
+        if (present) continue; // same original ancestor support, not a second boundary face
+        auto &side = brush->sides.emplace_back();
+        side.planenum = Phase5Plane(plane);
+        side.onnode = true;
+    }
+    ASSERT_TRUE(brush->update_bounds(false));
+    auto children = SupportedSplit(brush, Phase5Plane(partition));
+    ASSERT_TRUE(children.front); ASSERT_TRUE(children.back);
+    auto &actual = children.back->sides.back().w;
+    RecordProperty("actual_cut_area", actual.area());
+    RecordProperty("expected_cut_area", data["cap"]["area"].get<double>());
+    RecordProperty("parent_volume", BrushVolume(*brush));
+    RecordProperty("children_volume", BrushVolume(*children.front)+BrushVolume(*children.back));
+    EXPECT_NEAR(actual.area(), data["cap"]["area"].get<double>(), 1e-7);
+    EXPECT_NEAR(BrushVolume(*children.front)+BrushVolume(*children.back), BrushVolume(*brush), 1e-4);
+}
