+// Stronger local arithmetic reuses polylib's existing templated clipping.
+// No plane merging or replacement halfspaces are introduced.
+static std::optional<winding_t> ReconstructFace(const qplane3d &plane, const bspbrush_t &brush)
+{
+    using precise_winding_t = polylib::winding_base_t<polylib::winding_storage_heap_t<long double>>;
+    std::optional<precise_winding_t> w = precise_winding_t::from_plane(
+        qplane3<long double>(plane), static_cast<long double>(qbsp_options.worldextent.value()));
+    for (auto &support : brush.sides) {
+        const qplane3d &p = support.get_plane();
+        if (p.normal == plane.normal && p.dist == plane.dist) continue;
+        if (!w) return std::nullopt;
+        // clip_front's keepon=true retains ON, unlike clip_back's flag.
+        w = w->clip_front(-qplane3<long double>(p), 0, true);
+    }
+    if (!w) return std::nullopt;
+    winding_t result;
+    for (auto &point : *w) result.push_back(qvec3d(point));
+    return result;
+}
