+static size_t Phase5Plane(qplane3d p)
+{
+    size_t id = map.planes.size();
+    map.planes.emplace_back(qbsp_plane_t(p));
+    map.planes.emplace_back(qbsp_plane_t(-p));
+    return id;
+}
+static void Phase5Reset()
+{
+    map.reset(); qbsp_options.reset();
+    map.mtexinfos.emplace_back();
+    map.skip_texinfo = 0;
+    qbsp_options.target_version = &bspver_q1;
+    qbsp_options.target_game = bspver_q1.game;
+    qbsp_options.worldextent.set_value(65536, settings::source::COMMANDLINE);
+}
+TEST(phase5, Hull2ResolvedFrontFragment)
+{
+    Phase5Reset();
+    auto brush = BrushFromBounds({{-1360.000488281,-1488,172.03125}, {-1280,-1392,322.5093526806837}});
+    mapbrush_t source; source.line = parser_source_location("full-off.map", 13365);
+    brush->mapbrush = &source;
+    qplane3d plane{{1,0,0}, -1280.000244141};
+    EXPECT_EQ(supported_geometry::box_side(brush->bounds, plane), 3);
+    size_t id = Phase5Plane(plane);
+    const double parent_volume = BrushVolume(*brush);
+    auto children = SupportedSplit(brush, id);
+    ASSERT_TRUE(children.front); ASSERT_TRUE(children.back);
+    EXPECT_EQ(children.front->mapbrush, &source);
+    EXPECT_EQ(children.back->mapbrush, &source);
+    EXPECT_EQ(children.front->original_brush(), brush.get());
+    EXPECT_EQ(children.back->original_brush(), brush.get());
+    qvec3d witness{-1280.0001220705,-1440,236.73692674130805};
+    EXPECT_TRUE(children.front->contains_point(witness));
+    EXPECT_FALSE(children.back->contains_point(witness));
+    EXPECT_DOUBLE_EQ(children.front->bounds.mins()[0], plane.dist);
+    EXPECT_DOUBLE_EQ(children.front->bounds.maxs()[0], -1280);
+    EXPECT_NEAR(BrushVolume(*children.front)+BrushVolume(*children.back), parent_volume, parent_volume*1e-12);
+    EXPECT_EQ(brush->sides.size(), 6); // private preparation did not mutate parent
+    RecordProperty("front_width", children.front->bounds.maxs()[0]-children.front->bounds.mins()[0]);
+    RecordProperty("parent_volume", parent_volume);
+    RecordProperty("children_volume", BrushVolume(*children.front)+BrushVolume(*children.back));
+}
+TEST(phase5, NarrowQuadrilateralRankAndRealization)
+{
+    Phase5Reset();
+    std::ifstream file("/tmp/qqbsp-phase5/source/qartographer/phase5-witness.json");
+    nlohmann::json data; file >> data;
+    auto toplane = [](auto p) { return qplane3d{{p[0].template get<double>(),p[1].template get<double>(),p[2].template get<double>()},p[3].template get<double>()}; };
+    qplane3d partition = toplane(data["partition"]);
+    winding_t cap;
+    for (auto v : data["cap"]["vertices"]) cap.push_back({v[0],v[1],v[2]});
+    EXPECT_TRUE(WindingIsTiny(cap, 0.0001)); // former policy rejects this valid cut
+    EXPECT_EQ(supported_geometry::winding_rank(cap, partition), supported_geometry::rank_t::area);
+    auto brush = bspbrush_t::make_ptr();
+    for (auto f : data["region"]) {
+        auto &side = brush->sides.emplace_back();
+        side.planenum = Phase5Plane(toplane(f["p"]));
+        for (auto v : f["w"]) side.w.push_back({v[0],v[1],v[2]});
+    }
+    for (auto constraint : data["cap"]["ancestor_constraints"]) {
+        auto plane = toplane(constraint["p"]);
+        bool present = false;
+        for (auto &side : brush->sides)
+            present |= side.get_plane().get_normal() == plane.normal && side.get_plane().get_dist() == plane.dist;
+        if (present) continue; // same original ancestor support, not a second boundary face
+        auto &side = brush->sides.emplace_back();
+        side.planenum = Phase5Plane(plane);
+        side.onnode = true;
+    }
+    ASSERT_TRUE(brush->update_bounds(false));
+    auto children = SupportedSplit(brush, Phase5Plane(partition));
+    ASSERT_TRUE(children.front); ASSERT_TRUE(children.back);
+    auto &actual = children.back->sides.back().w;
+    RecordProperty("actual_cut_area", actual.area());
+    RecordProperty("expected_cut_area", data["cap"]["area"].get<double>());
+    RecordProperty("parent_volume", BrushVolume(*brush));
+    RecordProperty("children_volume", BrushVolume(*children.front)+BrushVolume(*children.back));
+    EXPECT_NEAR(actual.area(), data["cap"]["area"].get<double>(), 1e-7);
+    EXPECT_NEAR(BrushVolume(*children.front)+BrushVolume(*children.back), BrushVolume(*brush), 1e-4);
+}
